[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/upgrade_panel.gd" id="1_panel"]

[node name="UpgradePanel" type="PanelContainer"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -140.0
offset_top = -60.0
offset_right = 140.0
offset_bottom = 60.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"WindowPanel"
script = ExtResource("1_panel")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 5

[node name="Title" type="Label" parent="Layout"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Notice Board"
horizontal_alignment = 1

[node name="CoinsLabel" type="Label" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
horizontal_alignment = 1

[node name="UpgradeList" type="VBoxContainer" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2

[node name="Footer" type="Label" parent="Layout"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "[E] Buy      [Esc] Close"
horizontal_alignment = 1
