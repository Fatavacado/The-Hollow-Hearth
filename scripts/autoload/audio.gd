extends Node
## Sound effects and per-world ambience (autoload "Audio"). Scenes call `play(name)`; Main calls
## `set_ambience(world_id)` on arrival. Placeholder sounds are generated by tools/art/gen_audio.py.

const SOUNDS := {
	&"pickup": preload("res://assets/audio/pickup.wav"),
	&"store": preload("res://assets/audio/store.wav"),
	&"stir": preload("res://assets/audio/stir.wav"),
	&"cook_done": preload("res://assets/audio/cook_done.wav"),
	&"coin": preload("res://assets/audio/coin.wav"),
	&"bell": preload("res://assets/audio/bell.wav"),
	&"door": preload("res://assets/audio/door.wav"),
	&"ui": preload("res://assets/audio/ui.wav"),
	&"buy": preload("res://assets/audio/buy.wav"),
}
const AMBIENCE := {
	&"forest": preload("res://assets/audio/ambience_forest.wav"),
	&"tavern": preload("res://assets/audio/ambience_tavern.wav"),
}
const VOICES := 6
const SFX_DB := -8.0
const AMBIENCE_DB := -15.0

var _voices: Array[AudioStreamPlayer] = []
var _next_voice := 0
var _ambience: AudioStreamPlayer
var _ambience_id: StringName = &""


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS  # menu sounds while paused
	for i in VOICES:
		var voice := AudioStreamPlayer.new()
		voice.volume_db = SFX_DB
		add_child(voice)
		_voices.append(voice)
	_ambience = AudioStreamPlayer.new()
	_ambience.volume_db = AMBIENCE_DB
	add_child(_ambience)
	for stream: AudioStreamWAV in AMBIENCE.values():
		stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
		stream.loop_begin = 0
		stream.loop_end = int(stream.get_length() * stream.mix_rate)


func _exit_tree() -> void:
	# The audio thread releases stopped playbacks on its next mix steps. A loop still playing at
	# shutdown would otherwise be reported as a leaked resource, so stop everything and give the
	# audio thread a moment to let go before the engine tears down.
	for player: AudioStreamPlayer in _voices + [_ambience]:
		player.stop()
		player.stream = null
	OS.delay_msec(60)


func sound_names() -> Array:
	return SOUNDS.keys()


func play(sound: StringName, pitch_variation: float = 0.06) -> bool:
	var stream: AudioStream = SOUNDS.get(sound)
	if stream == null:
		return false
	var voice := _voices[_next_voice]
	_next_voice = (_next_voice + 1) % VOICES
	voice.stream = stream
	voice.pitch_scale = 1.0 + randf_range(-pitch_variation, pitch_variation)
	voice.play()
	return true


## Starts (or keeps) the loop for `world_id`. Returns false and goes silent if it has none.
func set_ambience(world_id: StringName) -> bool:
	var stream: AudioStream = AMBIENCE.get(world_id)
	if stream == null:
		_ambience_id = &""
		_ambience.stop()
		return false
	if world_id == _ambience_id and _ambience.playing:
		return true
	_ambience_id = world_id
	_ambience.stream = stream
	_ambience.volume_db = -40.0
	_ambience.play()
	create_tween().tween_property(_ambience, "volume_db", AMBIENCE_DB, 1.2)
	return true


func ambience_playing() -> bool:
	return _ambience.playing


func ambience_stream() -> AudioStream:
	return _ambience.stream
